{
    "name": "filefabrik/bootraiser",
    "version": "v2.0.2",
    "description": "Laravel boot helper for custom packages",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Filefabrik\\Bootraiser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Filefabrik\\Bootraiser\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "filefabrik",
            "email": "rt@filefabrik.com"
        }
    ],
    "keywords": [
        "laravel package development",
        "laravel 11",
        "livewire 3"
    ],
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.14",
        "livewire/livewire": "^v3.4",
        "mockery/mockery": "^1.5",
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^2.34",
        "pestphp/pest-plugin-drift": "^2.6",
        "pestphp/pest-plugin-laravel": "^2.3",
        "phpunit/phpunit": "^10.5",
        "filefabrik/bootraiser-testing": "~2.0",
        "phpstan/phpstan": "@stable"
    },
    "minimum-stability": "stable",
    "scripts": {
        "fix-style": "vendor/bin/php-cs-fixer fix",
        "check-style": "vendor/bin/php-cs-fixer fix --diff --dry-run",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve"
        ],
        "lint": [
            "@php vendor/bin/phpstan analyse"
        ],
        "test": [
            "@php vendor/bin/pest"
        ],
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon.dist"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Filefabrik\\Bootraiser\\Providers\\BootraiserServiceProvider",
                "Filefabrik\\Bootraiser\\Providers\\BootraiserCommandsServiceProvider",
                "Filefabrik\\Bootraiser\\Providers\\BootraiserDatabaseFactoryServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "prefer-stable": true,
    "repositories": {
        "packages/bootraiser-testing": {
            "type": "path",
            "url": "packages/bootraiser-testing",
            "options": {
                "symlink": true
            }
        }
    }
}
